# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_application_id
GUILD_ID=                           # optional — guild ID for fast command registration

# Spotify API Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Genius API Configuration (optional — lyrics work via web scraping without these)
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=

# Bot Settings (Optional - defaults will be used if not set)
EMBED_COLOR=#FF6B6B
SUPPORT_SERVER=https://discord.gg/7FMt59Urx7
WEBSITE=https://github.com/zeeinz-ux/HHMusicBOT
STATUS=🎵 HHMusic | /play

# Sharding Settings (for bots with 1000+ servers)
TOTAL_SHARDS=auto
SHARD_LIST=auto
SHARD_MODE=process
SHARD_RESPAWN=true
SHARD_SPAWN_DELAY=5500
SHARD_SPAWN_TIMEOUT=30000

# YouTube Cookie Settings
# Leave all empty if running on a VPS/headless server
# The bot will automatically fall back to iOS client (bypasses bot detection)
COOKIES_FROM_BROWSER=                  # chrome, firefox, edge, safari — leave empty for headless
COOKIES_FILE=                           # ./cookies.txt — leave empty for headless
COOKIES_CONTENT=                        # raw Netscape-format cookies.txt body (use on Railway/Render where the filesystem isn't persistent — content is materialized to a temp file at runtime)
